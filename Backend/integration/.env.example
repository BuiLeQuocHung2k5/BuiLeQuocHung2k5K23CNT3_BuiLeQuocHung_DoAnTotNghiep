# Example only. Runner does not auto-load this file; never overwrite Backend/.env.
# The isolated runner supplies these values privately after identity verification.
TEST_DB_NAME=libriflow_integration_test
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=
TEST_DB_USER=libriflow_it
TEST_DB_PASSWORD=
TEST_DB_SERVER_UUID=
TEST_DB_MAIN_SERVER_UUID=
# Only setup.mjs uses this confirmation; do not run setup on an existing database.
TEST_DB_SETUP_CONFIRM=
# Optional existing MySQL 8.0 binary; otherwise the runner uses its reviewed default.
MYSQLD_TEST_BINARY=
